# Vaultwise phone app. Copy to .env.local (in mobile/) and fill in. .env.local is git-ignored; this file isn't.
# Restart `npx expo start` after changing anything here (add --clear if a value doesn't change).
# Everything here is built into the app and visible to anyone who has it: never put a secret here.
# A blank value means "not set": the app keeps working as before without it.

# ─── Sign-in (Firebase) ────────────────────────────────────────────────────────
# The same Firebase web app config as NEXT_PUBLIC_FIREBASE_* in the repo root's .env.local.
# Firebase console → Project settings → General → "Your apps" → Web app → SDK config.
# Sign-in turns on once API key, project ID and app ID are all filled. Fill them at the same time
# as the server's Firebase lines (root .env.local), so the phone and the server agree.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ─── Server address (optional) ─────────────────────────────────────────────────
# Blank: the app uses port 3000 on the computer running Expo, which works on the same Wi-Fi.
# Set it when the phone can't reach that, e.g. a deployed server or a tunnel: https://example.com
EXPO_PUBLIC_API_URL=

# Don't set EXPO_PUBLIC_PRACTICE_ONLY here. The store build (eas.json "production") sets it.
