# Vaultwise server and web app. Copy to .env.local and fill in. .env.local is git-ignored; this file isn't, so keep it free of real values.
# Restart `npm run dev` after changing anything here.
# A blank value means "not set": the app keeps working as before without it.

# ─── AI (bill reading, ID reading, assistant, weekly tips) ─────────────────────
# Get a key at https://console.groq.com/keys
# Blank: no AI. Every bill and ID goes to a person, and the assistant is off.
GROQ_API_KEY=

# ─── Sign-in (Firebase) ────────────────────────────────────────────────────────
# Firebase console → Project settings → General → "Your apps" → Web app → SDK config.
# Also turn on Authentication → Sign-in method → Email/Password,
# and add your web domain under Authentication → Settings → Authorised domains.
#
# Filling FIREBASE_PROJECT_ID turns sign-in ON for the server: every request then needs a login,
# and your current no-login demo account isn't used. Leave it blank to keep the prototype.

# Server: checks sign-in tokens. The project ID (e.g. vaultwise-12345).
FIREBASE_PROJECT_ID=
# Server: sends password-reset emails. The same Web API key as NEXT_PUBLIC_FIREBASE_API_KEY below.
FIREBASE_WEB_API_KEY=

# Web app (these are public by design; Firebase web config isn't secret).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Who can open the reviewer console (/admin): signed-in emails, comma-separated.
# They must have verified their email in Firebase.
ADMIN_EMAILS=

# ─── ID checks and recovery ────────────────────────────────────────────────────
# Key used to match ID numbers without storing them. Required once sign-in is on.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Don't change it once IDs are saved, or they stop matching.
IDENTITY_SECRET=

# ─── Optional switches (defaults shown) ────────────────────────────────────────
# New sign-ups must verify an ID before money moves out. Default: on with sign-in, off without.
# KYC_ENFORCED=true
# Which ID checker to use. "practice" = AI + a person. "external" is the slot for a licensed partner.
# KYC_PROVIDER=practice
# WALLET_ENABLED=true
# RECOVERY_ENABLED=true

# ─── Optional advanced ─────────────────────────────────────────────────────────
# Behind a proxy that appends to X-Forwarded-For, how many proxies to trust (for rate limits).
# TRUST_PROXY_HOPS=0
# Where the database and uploaded photos live (default ./data).
# VAULTWISE_DATA_DIR=
# AI model overrides.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Address of the phone app's web preview, allowed to call the API in development.
# MOBILE_DEV_ORIGIN=http://localhost:8081
