# Vaultwise server and web app. Copy to .env.local and fill in. .env.local is git-ignored; this file isn't, so keep it free of real values.
# Restart `npm run dev` after changing anything here.
# A blank value means "not set": the app keeps working as before without it.

# ─── AI (bill reading, ID reading, assistant, weekly tips) ─────────────────────
# Get a key at https://console.groq.com/keys
# Blank: no AI. Every bill and ID goes to a person, and the assistant is off.
GROQ_API_KEY=

# ─── Sign-in (Firebase) ────────────────────────────────────────────────────────
# Firebase console → Project settings → General → "Your apps" → Web app → SDK config.
# Also turn on Authentication → Sign-in method → Email/Password,
# and add your web domain under Authentication → Settings → Authorised domains.
#
# Filling FIREBASE_PROJECT_ID turns sign-in ON for the server: every request then needs a login,
# and your current no-login demo account isn't used. Leave it blank to keep the prototype.

# Server: checks sign-in tokens. The project ID (e.g. vaultwise-12345).
FIREBASE_PROJECT_ID=
# Server: sends password-reset emails. The same Web API key as NEXT_PUBLIC_FIREBASE_API_KEY below.
FIREBASE_WEB_API_KEY=

# Web app (these are public by design; Firebase web config isn't secret).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Who can open the reviewer console (/admin): signed-in emails, comma-separated.
# They must have verified their email in Firebase.
ADMIN_EMAILS=

# ─── ID checks and recovery ────────────────────────────────────────────────────
# Key used to match ID numbers without storing them. Required once sign-in is on.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Don't change it once IDs are saved, or they stop matching.
IDENTITY_SECRET=

# ─── Texted codes (trusting a new phone, verifying a phone number, MPIN reset) ─
# Blank: texted codes are off, and those three actions answer 503 otp_unavailable.
# "test": no SMS; the code comes back in the API answer as testCode (refused on a production server
# unless OTP_TEST_ALLOWED=true). "twilio": real SMS through Twilio, with the three values below.
OTP_MODE=
# OTP_TEST_ALLOWED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# An E.164 number (+1...) or a Messaging Service SID (MG...).
TWILIO_FROM=

# ─── India ID checks by steps (PAN, Aadhaar via DigiLocker, bank account) ──────
# KYC_FLOW=steps switches India accounts from the ID photo to the three steps. Default: photo.
# KYC_FLOW=photo
# Which checker: "test" (fixed sample answers, for development) or "setu" (Setu's APIs, keys below).
# KYC_CHECKS_PROVIDER=test
# The test checker verifies anyone who types its sample PAN, and Setu's sandbox answers with sample data, so a
# production server refuses both unless this is true (a test-mode deployment).
# KYC_CHECKS_TEST_ALLOWED=false
# Where DigiLocker sends the person back (a public https URL on a live server). Default: <this site>/verify.
# KYC_DIGILOCKER_REDIRECT_URL=
# Setu (https://setu.co). Sandbox host by default in development. With NODE_ENV=production it must be set
# (https://dg.setu.co), and the sandbox host is refused unless KYC_CHECKS_TEST_ALLOWED=true.
# SETU_BASE_URL=https://dg-sandbox.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
# One product instance per check, or one for all three (SETU_PRODUCT_INSTANCE_ID).
# SETU_PAN_PRODUCT_INSTANCE_ID=
# SETU_DIGILOCKER_PRODUCT_INSTANCE_ID=
# SETU_RPD_PRODUCT_INSTANCE_ID=
SETU_PRODUCT_INSTANCE_ID=

# ─── Alerts on the phone (push notifications through Expo) ─────────────────────
# Alerts always show in the app. ALERTS_PUSH=false keeps them in the app only.
# ALERTS_PUSH=true
# Only needed if the Expo project has "enhanced push security" on.
EXPO_ACCESS_TOKEN=

# ─── Optional switches (defaults shown) ────────────────────────────────────────
# Rollback switches. false = the check is skipped (see docs/reference/configuration.md before using).
# MPIN_ENFORCED=true
# DEVICES_ENFORCED=true
# (MPIN_ENFORCED=false still checks the MPIN, with the wrong-try lock, for changing it, the phone number and devices.)
# A production server (NODE_ENV=production) refuses to start without FIREBASE_PROJECT_ID. true = start anyway
# as the open prototype (for a local `npm start` check only, never on a real server).
# ALLOW_PROTOTYPE_IN_PRODUCTION=false
# New sign-ups must verify an ID before money moves out. Default: on with sign-in, off without.
# KYC_ENFORCED=true
# Which ID checker to use. "practice" = AI + a person. "external" is the slot for a licensed partner.
# KYC_PROVIDER=practice
# WALLET_ENABLED=true
# RECOVERY_ENABLED=true

# ─── Optional advanced ─────────────────────────────────────────────────────────
# How many proxies stand in front of the server (for rate limits). Behind Caddy (deploy/) set 1: the app then
# reads the visitor's address from Cf-Connecting-Ip, X-Real-IP or X-Forwarded-For. Unset/0: those headers are
# ignored (a client could fake them) and only the per-person limit applies.
# TRUST_PROXY_HOPS=0
# Or name the one header your proxy overwrites with the visitor's address: cf-connecting-ip or x-real-ip.
# TRUST_PROXY_HEADER=
# The general limit per person and per address, requests per minute (default 120; 0 = off).
# RATE_LIMIT_PER_MINUTE=120
# Where the database and uploaded photos live (default ./data).
# VAULTWISE_DATA_DIR=
# Where the audit anchors go: the audit chain's head, appended at start-up and daily, checked by
# `npm run audit:verify` (default <VAULTWISE_DATA_DIR>/audit-anchors.jsonl). On the server it must stay inside the
# service's ReadWritePaths, and deploy/backup.sh needs the same value (AUDIT_ANCHOR_FILE in its cron file).
# AUDIT_ANCHOR_FILE=
# AI model overrides.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Address of the phone app's web preview, allowed to call the API in development.
# MOBILE_DEV_ORIGIN=http://localhost:8081
